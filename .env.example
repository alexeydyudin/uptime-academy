# Скопируй в .env и поменяй значения
# Секрет для подписи сессий: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=uptime

# true, когда сайт открывается по HTTPS (в проде обязательно)
COOKIE_SECURE=false
WEB_PORT=8080

# Ключи web push. Если оставить пустыми, API сгенерирует их сам и сохранит в БД.
# Сгенерировать вручную: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Сколько XP в сутки максимум засчитывается в лигу (защита от накрутки)
DAILY_XP_CAP=800
